{
    "name": "speso/laravel-ussd",
    "description": "Create ussd with ease",
    "license": "MIT",
    "authors": [
        {
            "name": "Isaac Sai",
            "email": "isaacsai030@gmail.com",
            "homepage": "https://speso.com"
        },
        {
            "name": "Benjamin Manford",
            "email": "benjaminmanford@gmail.com",
            "homepage": "https://speso.com"
        }
    ],
    "homepage": "https://github.com/spesohq/laravel-ussd",
    "keywords": ["Laravel", "Ussd"],
    "require": {
        "php": "^8.0",
        "illuminate/support": "~8|~9|~10|~11|~12|~13"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.0|^11.0",
        "orchestra/testbench": "~6|~7|~8|~9|~10|~11",
        "friendsofphp/php-cs-fixer": "^3.41"
    },
    "autoload": {
        "psr-4": {
            "Speso\\Ussd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Speso\\Ussd\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Speso\\Ussd\\UssdServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/php-cs-fixer fix"
    }
}
